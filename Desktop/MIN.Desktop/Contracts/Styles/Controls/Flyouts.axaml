<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="250">
           <Border Background="{DynamicResource SidebarSecondaryBackground}" Padding="20">
            <StackPanel Spacing="8">
                <Button Classes="card">
                     <Button.Flyout>
                        <Flyout Placement="Left" FlyoutPresenterClasses="cardDetails">
                            <Border>
                                <StackPanel Spacing="8">
                                     <DockPanel HorizontalSpacing="6">
                                        <TextBlock  DockPanel.Dock="Right"
                                            Text="Роль участника" />

                                        <SelectableTextBlock
                                            Classes="header5"
                                            Text="Имя участника" />
                                    </DockPanel>
                                    <TextBlock Text="В сети" />
                                </StackPanel>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                        <StackPanel Spacing="6">
                            <DockPanel HorizontalSpacing="6">
                                <TextBlock  DockPanel.Dock="Right"
                                    Text="Роль участника" />

                                <SelectableTextBlock
                                    Classes="header5"
                                    Text="Имя участника" />
                            </DockPanel>

                            <TextBlock
                                VerticalAlignment="Center"
                                Text="В сети" />
                        </StackPanel>
                    </Button>
                  <Button Content="Button with flyout">
                    <Button.Flyout >
                      <Flyout FlyoutPresenterClasses="buttons">
                          <StackPanel>
                            <Button
                            Classes="no-background">
                            <StackPanel>
                                <Svg Path="/Assets/Icons/file-upload.svg" />
                                <TextBlock VerticalAlignment="Center"
                                            Text="Отправить файл" />
                            </StackPanel>
                        </Button>

                        <Button
                            Classes="no-background">
                            <StackPanel>
                                <Svg Path="/Assets/Icons/rocket.svg" />
                                <TextBlock VerticalAlignment="Center"
                                            Text="Начать активность" />
                            </StackPanel>
                        </Button>
                         </StackPanel>
                      </Flyout>
                    </Button.Flyout>
                  </Button>

                    <SplitButton
                        DockPanel.Dock="Right">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Foreground="{DynamicResource TextOnPrimary}"
                                VerticalAlignment="Center">

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Кнопка с Flyout" />
                                </StackPanel>
                            </TextBlock>

                            <Svg
                                Height="18"
                                Margin="16,0,0,0"
                                Path="/Assets/Icons/loading.svg"
                                Classes="primary rotating"
                                VerticalAlignment="Center"/>
                        </StackPanel>

                        <SplitButton.Flyout>
                            <Flyout FlyoutPresenterClasses="buttons"
                                Placement="BottomEdgeAlignedRight">
                                <StackPanel>
                                    <Button Classes="no-background"
                                        HorizontalContentAlignment="Stretch">
                                            <StackPanel>
                                            <Svg Path="/Assets/Icons/network.svg" />
                                            <TextBlock VerticalAlignment="Center"
                                                Text="Найти комнаты в локальной сети" />
                                            </StackPanel>
                                    </Button>
                                    <Button Classes="no-background"
                                        HorizontalContentAlignment="Stretch">
                                        <StackPanel>
                                            <Svg Path="/Assets/Icons/globe.svg" />
                                            <TextBlock VerticalAlignment="Center"
                                                Text="Найти комнаты в web" />
                                            </StackPanel>
                                    </Button>
                                </StackPanel>
                                </Flyout>
                        </SplitButton.Flyout>
                    </SplitButton>

                    <SplitButton
                        DockPanel.Dock="Right">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Foreground="{DynamicResource TextOnPrimary}"
                                VerticalAlignment="Center">

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Кнопка с MenuFlyout" />
                                </StackPanel>
                            </TextBlock>

                            <Svg
                                Height="18"
                                Margin="16,0,0,0"
                                Path="/Assets/Icons/loading.svg"
                                Classes="primary rotating"
                                VerticalAlignment="Center"/>
                        </StackPanel>

                        <SplitButton.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Найти комнаты в локальной сети">
                                    <MenuItem.Icon>
                                        <Svg Path="/Assets/Icons/network.svg" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Найти комнаты в web">
                                    <MenuItem.Icon>
                                        <Svg Path="/Assets/Icons/globe.svg" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Удалить сообщение"
                               Classes="danger">
                                    <MenuItem.Icon>
                                        <Svg Path="/Assets/Icons/delete.svg" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                    </MenuFlyout>
                                </SplitButton.Flyout>
                    </SplitButton>
                </StackPanel>
            </Border>
        </Border>
    </Design.PreviewWith>
     <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
        <Setter Property="RenderTransformOrigin" Value="0%,0%" />
        <Setter Property="Opacity" Value="0" />

          <Style Selector="^ > Separator">
            <Setter Property="Margin" Value="0" />
        </Style>

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="0,0,-16,0">

                    <ScrollViewer>
                        <ItemsPresenter Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style.Animations>
            <Animation Duration="0:0:0.2" FillMode="Both">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="ScaleTransform.ScaleX" Value="0.95" />
                    <Setter Property="ScaleTransform.ScaleY" Value="0.95" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="ScaleTransform.ScaleX" Value="1" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="MenuItem">
       <Setter Property="Padding" Value="{DynamicResource PaddingMedium}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />

        <Style Selector="^ > TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>

        <Style Selector="^ > SelectableTextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>



        <Setter Property="Template">
            <ControlTemplate>
                <Border Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                        <ContentControl
                            Content="{TemplateBinding Icon}"
                            VerticalAlignment="Center" />
                        <ContentPresenter Name="PART_HeaderPresenter"
                            Content="{TemplateBinding Header}"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pressed /template/ Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardPressed}" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <Style Selector="^.danger">
            <Setter Property="Foreground" Value="{DynamicResource TextDanger}" />

            <Style Selector="^ > TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextDanger}" />
            </Style>

            <Style Selector="^ > Svg">
                <Setter Property="Css" Value="{DynamicResource SvgDangerStyle}" />
            </Style>

            <Style Selector="^ > SelectableTextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextDanger}" />
            </Style>
        </Style>

        <Style Selector="^.danger:pressed /template/ Border">
            <Setter Property="Background" Value="{DynamicResource TextDangerPress}" />
            <Setter Property="Opacity" Value="0.6" />
        </Style>

        <Style Selector="^.danger:pointerover">
            <Setter Property="Background" Value="{DynamicResource TextDangerHover}" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
    </Style>

    <Style Selector="MenuFlyoutPresenter Svg">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Css" Value="{DynamicResource SvgTextStyle}" />
    </Style>

     <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevated}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
        <Setter Property="RenderTransformOrigin" Value="0%,0%" />
        <Setter Property="Opacity" Value="0" />

          <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">

                    <!-- Здесь Padding принудительно установлен в PaddingSmall,
                    а то что-то по умочанию справа есть неубераемый padding -->
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{DynamicResource PaddingSmall}"/>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style.Animations>
            <Animation Duration="0:0:0.2" FillMode="Both">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                    <Setter Property="ScaleTransform.ScaleX" Value="0.95" />
                    <Setter Property="ScaleTransform.ScaleY" Value="0.95" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="ScaleTransform.ScaleX" Value="1" />
                    <Setter Property="ScaleTransform.ScaleY" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="FlyoutPresenter.cardDetails /template/ ContentPresenter">
        <Setter Property="Padding" Value="{DynamicResource PaddingCard}" />

        <Style Selector="^ Svg">
            <Setter Property="Css" Value="{DynamicResource SvgTextStyle}" />
        </Style>
    </Style>

    <Style Selector="FlyoutPresenter.cardDetails Border">
        <Setter Property="MinWidth" Value="200" />
    </Style>

    <Style Selector="FlyoutPresenter.cardDetails TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
</Styles>
