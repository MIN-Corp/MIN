<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
           <Border Background="{DynamicResource SidebarSecondaryBackground}" Padding="20">
                <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Styles>
                        <Style Selector="Button">
                            <Setter Property="Margin" Value="5"></Setter>
                        </Style>
                    </StackPanel.Styles>

                    <Button>Просто кнопка</Button>
                    <Button Classes="secondary">Вторичное действие</Button>
                    <Button Classes="danger">Опасное действие</Button>
                    <Button Classes="icon">
                        <Svg Path="/Assets/Icons/gear.svg" />
                    </Button>
                      <Button Classes="icon primary">
                        <Svg Path="/Assets/Icons/send.svg" />
                    </Button>
                </StackPanel>
                <Button Classes="card"
                        Margin="0,4">
                        <StackPanel Spacing="6">
                            <DockPanel HorizontalSpacing="6">
                                <TextBlock  DockPanel.Dock="Right"
                                    Text="Роль участника" />

                                <SelectableTextBlock
                                    Classes="header5"
                                    Text="Имя участника" />
                            </DockPanel>

                            <TextBlock
                                VerticalAlignment="Center"
                                Text="В сети" />
                        </StackPanel>
                    </Button>
                     <Button Classes="card selected"
                        Margin="0,4">
                        <StackPanel Spacing="6">
                            <DockPanel HorizontalSpacing="6">
                                <TextBlock  DockPanel.Dock="Right"
                                    Text="Роль участника" />

                                <SelectableTextBlock
                                    Classes="header5"
                                    Text="Имя участника" />
                            </DockPanel>

                            <TextBlock
                                VerticalAlignment="Center"
                                Text="В сети" />
                        </StackPanel>
                    </Button>
                    <Button Classes="no-background">Без фона</Button>

                    <SplitButton
                        DockPanel.Dock="Right">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Foreground="{DynamicResource TextOnPrimary}"
                                VerticalAlignment="Center">

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Кнопка с MenuFlyout" />
                                </StackPanel>
                            </TextBlock>

                            <Svg
                                Height="18"
                                Margin="16,0,0,0"
                                Path="/Assets/Icons/loading.svg"
                                Classes="primary rotating"
                                VerticalAlignment="Center"/>
                        </StackPanel>
                    </SplitButton>

                </StackPanel>
            </Border>
        </Border>
    </Design.PreviewWith>

    <!-- Primary (Default) -->

    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="RenderTransform" Value="scale(0.98)"/>
        <Setter Property="Background" Value="{DynamicResource PrimaryPressed}"/>
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="{DynamicResource PrimaryHover}"/>
    </Style>
    
    <Style Selector="SplitButton /template/ Button /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="SplitButton:pointerover /template/ Button#PART_PrimaryButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryHover}" />
    </Style>

    <Style Selector="SplitButton:pressed /template/ Button#PART_PrimaryButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryPressed}" />
        <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>

    <Style Selector="SplitButton:pointerover /template/ Button#PART_SecondaryButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryHover}" />
    </Style>

    <Style Selector="SplitButton:pressed /template/ Button#PART_SecondaryButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryPressed}" />
        <Setter Property="RenderTransform" Value="scale(0.98)" />
    </Style>

    <Style Selector="SplitButton:flyout-open /template/ Button#PART_PrimaryButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryHover}"/>
    </Style>

    <Style Selector="SplitButton:flyout-open /template/ Button#PART_SecondaryButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PrimaryHover}"/>
    </Style>

    <Style Selector="Button, SplitButton">
        <Setter Property="Background" Value="{DynamicResource Primary}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextOnPrimary}"/>
        <Setter Property="Padding" Value="{DynamicResource PaddingButton}"/>
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusDefault}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>

        <Setter Property="RenderTransform" Value="scale(1)"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1"/>
            </Transitions>
        </Setter>

        <Style Selector="^ TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextOnPrimary}" />
        </Style>

        <Style Selector="^ SelectableTextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextOnPrimary}" />
        </Style>

        <Style Selector="^ Svg">
            <Setter Property="Css" Value="{DynamicResource SvgPrimaryStyle}" />
        </Style>

        <Style Selector="^.busy">
            <Setter Property="Opacity" Value="1" />
            <Style.Animations>
                <Animation
                    Duration="0:0:.75"
                    Easing="SineEaseInOut"
                    IterationCount="INFINITE"
                    PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.3" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="^.anycontent">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            
            <Style Selector="^:pressed /template/ ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
            </Style>
        </Style>

        <Style Selector="^.icon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="{DynamicResource PaddingMedium}" />
            <Setter Property="CornerRadius" Value="48" />

            <Style Selector="^:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource TextIconHover}"/>
                <Setter Property="TextBlock.TextDecorations" Value="Underline" />
            </Style>

            <Style Selector="^:pressed /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource TextIcon}"/>
                <Setter Property="RenderTransform" Value="scale(0.98)"/>
            </Style>

            <Style Selector="^ Svg">
                <Setter Property="Width" Value="{DynamicResource IconButton}" />
                <Setter Property="Height" Value="{DynamicResource IconButton}" />
                <Setter Property="Css" Value="{DynamicResource SvgTextStyle}" />
            </Style>

             <Style Selector="^.small">
                <Setter Property="Width" Value="{DynamicResource IconSmall}" />
                <Setter Property="Height" Value="{DynamicResource IconSmall}" />
            </Style>
        </Style>

        <Style Selector="^.close">
            <Style Selector="^:pointerover /template/ ContentPresenter">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="{DynamicResource StatusError}" />
            </Style>
        </Style>

        <Style Selector="^.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceCard}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="{DynamicResource PaddingCard}" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLarge}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

             <Style Selector="^ TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            </Style>

            <Style Selector="^ SelectableTextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            </Style>

            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource SurfaceCardHover}" />
            </Style>

            <Style Selector="^:pressed">
                <Setter Property="Background" Value="{DynamicResource SurfaceCardPressed}" />

                <Style Selector="^ TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextOnCardSelected}" />
                </Style>

                <Style Selector="^ SelectableTextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextOnCardSelected}" />
                </Style>
            </Style>

            <Style Selector="^.selected">
                <Setter Property="Background" Value="{DynamicResource Primary}" />

                <Style Selector="^ TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextOnCardSelected}" />
                </Style>

                <Style Selector="^ SelectableTextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextOnCardSelected}" />
                </Style>
            </Style>

            <Style Selector="^.selected:pointerover">
                <Setter Property="Background" Value="{DynamicResource PrimaryHover}" />
            </Style>
        </Style>

        <Style Selector="^.no-background">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>

            <Style Selector="^ TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            </Style>

            <Style Selector="^ Svg">
                <Setter Property="Css" Value="{DynamicResource SvgDefaultStyle}" />
            </Style>
        </Style>

        <Style Selector="^.no-background:pressed  /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardPressed}" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <Style Selector="^.no-background:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <Style Selector="^.file">
            <Setter Property="Background" Value="{DynamicResource FileMessageIconBackground}"/>
        </Style>

        <Style Selector="^.file:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource FileMessageIconBackgroundPressed}" />
        </Style>

        <Style Selector="^.file:pointerover">
            <Setter Property="Background" Value="{DynamicResource FileMessageIconBackgroundHover}" />
        </Style>

        <Style Selector="^.danger">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TextDanger}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDanger}" />
            <Setter Property="BorderThickness" Value="2"/>

            <Style Selector="^ > TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextDanger}" />
            </Style>

            <Style Selector="^ > Svg">
                <Setter Property="Css" Value="{DynamicResource SvgDangerStyle}" />
            </Style>

            <Style Selector="^ > SelectableTextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextDanger}" />
            </Style>
        </Style>

        <Style Selector="^.danger:pressed /template/ ContentPresenter">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource TextDangerPress}" />
        </Style>

        <Style Selector="^.danger:pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource TextDangerHover}" />
        </Style>

        <!-- Secondary -->

        <Style Selector="^.secondary">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
            <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="^.secondary:pointerover /template/ ContentPresenter">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{DynamicResource Primary}"/>
        </Style>

        <Style Selector="^.primary">
            <Setter Property="Foreground" Value="{DynamicResource Primary}"/>

            <Style Selector="^ Svg">
                <Setter Property="Css" Value="{DynamicResource SvgAccentStyle}" />
            </Style>
        </Style>

        <Style Selector="^.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource PrimaryHover}"/>
        </Style>

         <Style Selector="^.primary:pointerover">
             <Style Selector="^ Svg">
                <Setter Property="Css" Value="{DynamicResource SvgPrimaryStyle}" />
            </Style>
        </Style>

        <Style Selector="^.on-primary">
            <Setter Property="Background" Value="{DynamicResource SurfaceCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Primary}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="2"/>

            <Style Selector="^ TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>

            <Style Selector="^ SelectableTextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>
        </Style>
    </Style>
</Styles>
