<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:vm="using:MIN.Desktop.ViewModels.Cards.Messages.Files"
             xmlns:i="using:Avalonia.Xaml.Interactivity"
             xmlns:behaviors="using:MIN.Desktop.Infrastructure.Behaviors"
             xmlns:converters="using:MIN.Desktop.Infrastructure.Converters"
             xmlns:focusBehaviours="using:MIN.Desktop.Infrastructure.Behaviors.Focus"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="20"
             x:DataType="vm:ChatFileMessageViewModel"
             x:Class="MIN.Desktop.Views.Cards.Messages.ChatFileMessageView">

    <Design.DataContext>
        <vm:ChatFileMessageViewModel/>
    </Design.DataContext>

   <Border Classes="message-row"
        Margin="{Binding TimePadding}"
        Classes.private="{Binding IsPrivate}"
        Classes.selected="{Binding IsSelected}">

        <Border.ContextFlyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Скопировать имя"
                    Command="{Binding CopyNameToClipboardCommand}">
                    <MenuItem.Icon>
                        <Svg Path="/Assets/Icons/copy.svg" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Показать в проводнике"
                    IsVisible="{Binding Downloaded}"
                    Command="{Binding ShowInFolderCommand}">
                    <MenuItem.Icon>
                        <Svg Path="/Assets/Icons/folder.svg" />
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="Редактировать"
                    IsEnabled="{Binding IsAvaibleForNetwork}" 
                    Command="{Binding ToggleEditingMessageCommand}">
                    <MenuItem.IsVisible>
                        <MultiBinding Converter="{StaticResource AndMultiConverter}">
                            <Binding Path="IsLocal" />
                            <Binding Path="!IsEditing" />
                        </MultiBinding>
                    </MenuItem.IsVisible>

                    <MenuItem.Icon>
                        <Svg Path="/Assets/Icons/pencil.svg" />
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem Header="Отменить редактирование"
                    Command="{Binding ToggleEditingMessageCommand}">
                    <MenuItem.IsVisible>
                        <MultiBinding Converter="{StaticResource AndMultiConverter}">
                            <Binding Path="IsLocal" />
                            <Binding Path="IsEditing" />
                        </MultiBinding>
                    </MenuItem.IsVisible>

                    <MenuItem.Icon>
                        <Svg Path="/Assets/Icons/pencil-slash.svg" />
                    </MenuItem.Icon>
                </MenuItem>

                <Separator />

                <MenuItem Header="Ответить"
                    Command="{Binding SetAsReplyCommand}">
                    <MenuItem.Icon>
                        <Svg Path="/Assets/Icons/answer.svg" />
                    </MenuItem.Icon>
                </MenuItem>

                <Separator />

                <MenuItem Header="Удалить сообщение"
                    Command="{Binding DeleteMessageCommand}"
                    Classes="danger">
                     <MenuItem.IsVisible>
                        <MultiBinding Converter="{StaticResource AndMultiConverter}">
                            <Binding Path="IsLocal" />
                            <Binding Path="!IsTransfering" />
                        </MultiBinding>
                    </MenuItem.IsVisible>

                    <MenuItem.Icon>
                        <Svg Path="/Assets/Icons/delete.svg" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuFlyout>
        </Border.ContextFlyout>

        <Border Classes="message"
            MaxWidth="400"
            Padding="{DynamicResource PaddingMedium}"
            Classes.self="{Binding IsLocal}">
            <StackPanel Spacing="8">
                <DockPanel HorizontalSpacing="8" IsVisible="{Binding !RemoveHeaders}">
                    <TextBlock
                        FontWeight="Bold"
                        Text="{Binding SenderName}" />

                    <TextBlock
                        IsVisible="{Binding IsHost}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Text="Хост"
                        DockPanel.Dock="Right" />
                </DockPanel>

                <Border Classes.self="{Binding IsLocal}"
                    Opacity="0.7"
                    IsVisible="{Binding ReplyToDescription,
                        Converter={converters:NonEqualityConverter},
                        ConverterParameter={x:Null}}">
                    <Button Padding="{DynamicResource PaddingSmall}"
                        Classes="no-background"
                        HorizontalContentAlignment="{Binding IsLocal,
                            Converter={converters:IsSelfBoolHorizontalToConverter}}"
                        Content="{Binding ReplyToDescription,
                            Converter={converters:TruncateWithEllipsisConverter},
                            ConverterParameter=80}"/>
                </Border>

                <DockPanel HorizontalSpacing="8">
                    <TextBlock
                        DockPanel.Dock="Right"
                        Classes="info"
                        IsVisible="{Binding Content,
                            Converter={x:Static StringConverters.IsNullOrEmpty}}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Text="{Binding Timestamp}" />

                    <Grid
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RowSpacing="8"
                        ColumnSpacing="8"
                        RowDefinitions="Auto, Auto, Auto"
                        ColumnDefinitions="Auto, *">
                        <Border
                            Grid.RowSpan="3"
                            Grid.Row="0"
                            Grid.Column="0"
                            Height="70"
                            Width="70"
                            Margin="4,0"
                            Background="{DynamicResource Secondary}">
                            <Button
                                Classes="file"
                                Command="{Binding InteractionClickCommand}">
                                <Panel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                <Svg
                                    Height="50" Width="50"
                                    Path="{Binding FileDownloadState,
                                    Converter={converters:FileDownloadStateToSvgConverter}}" />

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Text="{Binding InteractionFileStatus}" />
                                </Panel>
                            </Button>
                            <Interaction.Behaviors>
                                <EventTriggerBehavior EventName="PointerEntered">
                                    <InvokeCommandAction Command="{Binding InteractionMouseEnterCommand}" />
                                </EventTriggerBehavior>
                                <EventTriggerBehavior EventName="PointerExited">
                                    <InvokeCommandAction Command="{Binding InteractionMouseLeaveCommand}" />
                                </EventTriggerBehavior>
                            </Interaction.Behaviors>
                        </Border>

                        <SelectableTextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Classes="header5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            MaxLines="2"
                            TextTrimming="CharacterEllipsis"
                            Text="{Binding FileMetadataMessage.FileName}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Text="{Binding UniversalFileStatus}" />

                        <ProgressBar
                            Grid.Row="2"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Value="{Binding DownloadProgress}"
                            IsVisible="{Binding IsTransfering}"/>
                    </Grid>
                </DockPanel>

                <DockPanel HorizontalSpacing="4"
                    IsVisible="{Binding Content,
                        Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock
                        DockPanel.Dock="Right"
                        Classes="info"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Text="{Binding Timestamp}" />

                    <TextBlock
                        DockPanel.Dock="Right"
                        Classes="info"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        IsVisible="{Binding IsEdited}"
                        Text="(изменено)" />

                    <SelectableTextBlock
                        Classes="chat"
                        Margin="4,0,0,4"
                        IsVisible="{Binding !IsEditing}"
                        Text="{Binding Content}">
                        <i:Interaction.Behaviors>
                            <behaviors:CustomContextMenuBehavior />
                        </i:Interaction.Behaviors>
                    </SelectableTextBlock>
                </DockPanel>

                <DockPanel HorizontalSpacing="4"
                    IsVisible="{Binding IsEditing}">
                    <Button
                        DockPanel.Dock="Right"
                        Classes="icon"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        HotKey="Escape"
                        Command="{Binding CancelEditMessageCommand}">
                            <Svg Path="/Assets/Icons/close.svg" />
                    </Button>

                    <Button
                        DockPanel.Dock="Right"
                        Classes="icon"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        HotKey="Enter"
                        Command="{Binding ConfirmEditMessageCommand}">
                            <Svg Path="/Assets/Icons/confirm.svg" />
                    </Button>

                    <TextBox
                        focusBehaviours:FocusOnConditionTrueBehavior.Condition="{Binding IsEditing}"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        MaxLines="-1"
                        Text="{Binding EditContent}">
                    </TextBox>
                </DockPanel>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
