<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:vm="using:MIN.Desktop.ViewModels.Cards.Messages.Sessions"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="20"
             x:DataType="vm:ChatSessionMessageViewModel"
             x:Class="MIN.Desktop.Views.Cards.Messages.ChatSessionMessageView">

    <Design.DataContext>
        <vm:ChatSessionMessageViewModel/>
    </Design.DataContext>

    <Border Classes="message-row"
        Margin="{Binding TimePadding}"
        Classes.private="{Binding IsPrivate}"
        Classes.selected="{Binding IsSelected}">

        <Border.ContextFlyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                <MenuItem Header="Ответить"
                    Command="{Binding SetAsReplyCommand}">
                    <MenuItem.Icon>
                        <Svg Path="/Assets/Icons/answer.svg" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuFlyout>
        </Border.ContextFlyout>

        <Border Classes="message"
            MaxWidth="400"
            Padding="{DynamicResource PaddingMedium}"
            Classes.self="{Binding IsLocal}"
            Classes.unactive="{Binding IsNotAvailable}">

            <StackPanel Spacing="8">
                <DockPanel HorizontalSpacing="8" IsVisible="{Binding !RemoveHeaders}">
                    <TextBlock
                        FontWeight="Bold"
                        Text="{Binding SenderName}" />

                    <TextBlock
                        IsVisible="{Binding IsHost}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Text="Хост"
                        DockPanel.Dock="Right" />
                </DockPanel>

                <DockPanel HorizontalSpacing="8">
                    <TextBlock
                        DockPanel.Dock="Right"
                        Classes="info"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Text="{Binding Timestamp}" />

                    <Grid
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        RowSpacing="8"
                        ColumnSpacing="8"
                        RowDefinitions="Auto, Auto"
                        ColumnDefinitions="Auto, *">
                        <Border
                            Grid.RowSpan="2"
                            Grid.Row="0"
                            Grid.Column="0"
                            Classes="card"
                            Height="100"
                            Width="100">
                            <Image
                                Stretch="Uniform"
                                Source="{Binding SessionImage}" />
                        </Border>

                        <SelectableTextBlock
                            Grid.Row="0"
                            Grid.Column="1"
                            Classes="header5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            MaxLines="2"
                            TextTrimming="CharacterEllipsis"
                            Text="{Binding SessionTitle}" />

                        <Button
                            Grid.Row="1"
                            Grid.Column="1"
                            Classes.on-primary="{Binding IsLocal}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Command="{Binding JoinSessionCommand}">

                            <Button.IsEnabled>
                                <MultiBinding Converter="{StaticResource AndMultiConverter}">
                                    <Binding Path="CanJoin" />
                                    <Binding Path="IsAvaibleForNetwork" />
                                </MultiBinding>
                            </Button.IsEnabled>

                            <TextBlock
                                TextWrapping="Wrap"
                                Text="{Binding JoinButtonStateText}" />
                        </Button>
                    </Grid>
                </DockPanel>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
