<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MIN.Desktop.ViewModels.Windows"
        xmlns:controls="using:MIN.Desktop.TemplatedControls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Width="960"
        Height="540"
        MinWidth="480"
        MinHeight="270"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        x:Class="MIN.Desktop.Views.Windows.ScreenDemoViewerWindow"
        x:DataType="vm:ScreenDemoViewerViewModel"
        Title="MIN - Демонстрация экрана">

    <DockPanel>
        <controls:CustomTitleBar CanMinimize="True" CanMaximize="True" />
        <DockPanel>
            <Border DockPanel.Dock="Bottom"
                    Classes="footer">
                <Button
                    Command="{Binding LeaveDemoCommand}"
                    Content="Покинуть демонстрацию"
                    Classes="secondary"
                    FontWeight="Bold"
                    HorizontalAlignment="Right" />
            </Border>

            <Border>
                <Panel>
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                IsVisible="{Binding !HasFrame}">
                        <Svg Path="/Assets/Icons/loading.svg"
                             Width="32" Height="32"
                             HorizontalAlignment="Center"
                             Classes="rotating" />
                        <TextBlock Text="Ожидание потока демонстрации..."
                                   Opacity="0.7"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <Image x:Name="ScreenImage"
                           Source="{Binding FrameImage}"
                           Stretch="Uniform"
                           IsVisible="{Binding HasFrame}" />
                </Panel>
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
