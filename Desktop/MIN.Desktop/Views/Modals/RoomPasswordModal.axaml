<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MIN.Desktop.ViewModels.Modals"
        xmlns:controls="using:MIN.Desktop.TemplatedControls"
        xmlns:behaviors="using:MIN.Desktop.Infrastructure.Behaviors.Focus"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="300"
        MinWidth="300"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        x:Class="MIN.Desktop.Views.Modals.RoomPasswordModal"
        x:DataType="vm:RoomPasswordViewModel"
        Title="MIN - Пароль комнаты">

    <Design.DataContext>
        <vm:RoomPasswordViewModel/>
    </Design.DataContext>

    <DockPanel>
        <controls:CustomTitleBar CanMinimize="False" CanMaximize="False" />

        <StackPanel>
            <StackPanel Classes="form" Margin="24">
                <Border Classes="card">
                    <StackPanel Classes="form">
                        <TextBlock Text="Комната защищена паролем. Введите пароль:" />
                        <TextBox
                            MaxLength="120"
                            MaxWidth="400"
                            PasswordChar="•"
                            Text="{Binding Password}"
                            PlaceholderText="Введите пароль...">
                            <Interaction.Behaviors>
                                <behaviors:FocusOnViewShowBehavior />
                            </Interaction.Behaviors>
                        </TextBox>
                    </StackPanel>
                </Border>
            </StackPanel>
            <Border Classes="footer">
                <Panel>
                    <Button
                        Command="{Binding CloseCommand}"
                        Content="Отмена"
                        Classes="secondary"
                        FontWeight="Bold"
                        HorizontalAlignment="Left"
                        HotKey="Escape" />
                    <Button
                        Command="{Binding ProceedCommand}"
                        Content="Подключиться"
                        HorizontalAlignment="Right"
                        HotKey="Enter" />
                </Panel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
