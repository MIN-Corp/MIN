<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:vm="using:MIN.Desktop.ViewModels.Pages"
             xmlns:converters="using:MIN.Desktop.Infrastructure.Converters"
             xmlns:designer="using:MIN.Desktop.Contracts.Designer"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="720"
             x:DataType="vm:SettingsSideBarViewModel"
             Padding="{DynamicResource PaddingPage}"
             DockPanel.Dock="Left"
             x:Class="MIN.Desktop.Views.Views.Left.SettingsSideBarView">

    <Design.DataContext>
        <designer:DesignerSettingsViewModel/>
    </Design.DataContext>

    <Border Classes="appear-from-left"
            Background="{DynamicResource SidebarSecondaryBackground}"
            Padding="{DynamicResource PaddingPage}"
            CornerRadius="{DynamicResource CornerRadiusLarge}">
        <DockPanel VerticalSpacing="10" >
            <DockPanel HorizontalSpacing="16" DockPanel.Dock="Top" >
                <Button Command="{Binding BackCommand}"
                    DockPanel.Dock="Left"
                    Classes="icon">
                    <Svg Path="/Assets/Icons/arrow-left.svg" />
                </Button>

                <TextBlock Classes="header2" VerticalAlignment="Center">
                    Настройки
                </TextBlock>
            </DockPanel>

            <TextBlock DockPanel.Dock="Bottom"
                       Classes="small"
                       Opacity="0.7"
                       HorizontalAlignment="Center"
                       Text="{Binding Version}"/>

            <ScrollViewer Classes="main">
                <StackPanel Spacing="6">

                    <!-- Default Name -->

                    <DockPanel HorizontalSpacing="12">
                        <TextBlock MaxWidth="68"
                            VerticalAlignment="Center">
                            Имя по умолчанию
                        </TextBlock>

                        <TextBox Text="{Binding ParticipantName}"
                            PlaceholderText="Введите имя..." />
                    </DockPanel>

                    <!-- Room discovery time -->
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center">
                            Время поиска комнат (в мс.)
                        </TextBlock>

                        <TextBox Text="{Binding DiscoveryTimeout,
                            Converter={converters:IntToStringConverter}}"
                            Grid.Column="1"/>
                    </Grid>

                    <!-- Udp port -->
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBlock Grid.Column="0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center">
                            UDP Порт комнат (Лучше не менять, по умолчанию 42069)
                        </TextBlock>

                        <TextBox Text="{Binding DiscoveryPort,
                            Converter={converters:IntToStringConverter}}"
                            Grid.Column="1"/>
                    </Grid>

                    <!-- App theme -->

                    <DockPanel HorizontalSpacing="12">
                        <TextBlock VerticalAlignment="Center">
                            Тема
                        </TextBlock>

                        <ToggleSwitch IsChecked="{Binding LightThemeEnabled}"
                            OffContent="Тёмная"
                            OnContent="Светлая"/>
                     </DockPanel>

                    <!-- Audio -->

                    <DockPanel HorizontalSpacing="12">
                        <TextBlock VerticalAlignment="Center">Микрофон</TextBlock>
                        <ComboBox ItemsSource="{Binding InputDevices}"
                                  SelectedIndex="{Binding Settings.InputDeviceNumber}"
                                  HorizontalAlignment="Stretch"/>
                    </DockPanel>

                    <TextBlock Text="{Binding #InputVolumeSlider.Value, StringFormat='Громкость микрофона: {0:F0}%'}" />
                    <Slider x:Name="InputVolumeSlider" Minimum="0" Maximum="100" Value="{Binding Settings.InputDeviceVolume}" />

                    <TextBlock Text="{Binding #InputSensitivitySlider.Value, StringFormat='Чувствительность микрофона: {0:F0} дБ'}" />
                    <Slider x:Name="InputSensitivitySlider" Minimum="-60" Maximum="-10" Value="{Binding Settings.InputDeviceSensitivity}" />

                    <DockPanel HorizontalSpacing="12">
                        <TextBlock VerticalAlignment="Center">Шумоподавление</TextBlock>
                        <ComboBox ItemsSource="{Binding NoiseReductions}"
                                  SelectedIndex="{Binding ChosenNoiseReduction}"
                                  HorizontalAlignment="Stretch"/>
                    </DockPanel>

                    <DockPanel HorizontalSpacing="12">
                        <TextBlock VerticalAlignment="Center">Динамики</TextBlock>
                        <ComboBox ItemsSource="{Binding OutputDevices}"
                                  SelectedIndex="{Binding Settings.OutputDeviceNumber}"
                                  HorizontalAlignment="Stretch"/>
                    </DockPanel>

                    <TextBlock Text="{Binding #OutputVolumeSlider.Value, StringFormat='Громкость динамиков: {0:F0}%'}" />
                    <Slider x:Name="OutputVolumeSlider" Minimum="0" Maximum="100" Value="{Binding Settings.OutputDeviceVolume}" />

                    <!-- Scan sessions -->

                    <Button
                        Command="{Binding ScanSessionsCommand}"
                        VerticalAlignment="Center">
                        Обновить список сессий
                    </Button>

                    <TextBlock Classes="info"
                               VerticalAlignment="Center">
                        Когда вы установили новую сессию
                    </TextBlock>

                    <!-- Logs -->

                    <Button
                        Command="{Binding AnnounceErrorAtIssuesCommand}"
                        VerticalAlignment="Center">
                        Сообщить о проблеме
                    </Button>

                    <TextBlock Classes="info"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center">
                        Если возникли проблемы, напишите как issue по ссылке,
                        желательно указав описание ошибки и какие действия к ней привели
                        (в логах или в уведомлении)
                    </TextBlock>

                    <Button
                        Classes="secondary"
                        Command="{Binding OpenLogsCommand}"
                        VerticalAlignment="Center">
                        Открыть логи
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
