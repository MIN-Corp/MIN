<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="OpenTK.Audio.OpenAL" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\MIN.Audio.Services.Contracts\MIN.Audio.Services.Contracts.csproj" />
        <ProjectReference Include="..\..\..\Helpers\MIN.Helpers.Contracts\MIN.Helpers.Contracts.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Native\openal32.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            <Link>openal32.dll</Link>
        </None>
        <Folder Include="Native\" />
    </ItemGroup>
</Project>